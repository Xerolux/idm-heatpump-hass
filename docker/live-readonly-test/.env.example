# =============================================================================
# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored and MUST NEVER be committed. The real PIN only ever
# lives in .env and in the generated (gitignored) HA .storage file.
# =============================================================================

# Real heat pump address (read-only access only — enforced by the proxies).
IDM_HOST=192.168.178.103
IDM_MODBUS_PORT=502
IDM_WEB_PORT=80

# Navigator 2.0 local web PIN. Leave empty to disable the web supplement.
# Replace the placeholder with your real PIN only in .env (gitignored).
IDM_WEB_PIN=YOUR_WEB_PIN_HERE

# Home Assistant onboarding credentials (local test instance only).
HA_USERNAME=idmadmin
HA_PASSWORD=ChangeMeTestOnly_2026!

# Integration options for the preseeded config entry.
HA_SCAN_INTERVAL=30
HA_HEATING_CIRCUITS=a
HA_HIDE_UNUSED=true

# Host port mappings (avoid clashing with any existing HA on 8123).
HA_HOST_PORT=8123
MODBUS_PROXY_HOST_PORT=5020
WEB_PROXY_HOST_PORT=8080

# Stability test duration (minutes).
STABILITY_MINUTES=60

# Log level for the proxies.
LOG_LEVEL=INFO

# API wheel filename (built by scripts/build.ps1 from the local API repo).
API_WHEEL=idm_heatpump_api-0.8.5-py3-none-any.whl
